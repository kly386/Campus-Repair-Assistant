# Campus Repair Assistant — MySQL 8 从库配置（读写分离）
# 目标位置：VM4（192.168.56.104）的 /etc/mysql/mysql.conf.d/campus.cnf
# 重启生效：sudo systemctl restart mysql
# 主库配置见 mysqld-campus.cnf；复制链路建立见 docs/MySQL读写分离部署文档.md

[mysqld]
# 只监听 Host-Only 地址，不暴露到 NAT/公网
bind-address = 192.168.56.104
mysqlx-bind-address = 127.0.0.1

default-time-zone = '+08:00'
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

max_connections = 200
innodb_buffer_pool_size = 512M

# ===== 主从复制：从库侧 =====
# server-id 与主库（=1）不同即可；relay-log 存放从主库拉取的 binlog
server-id = 2
relay-log = campus-relay
# 必须与主库一致，否则复制链路无法建立
gtid_mode                = ON
enforce_gtid_consistency = ON

# 只读实例：应用账号等普通连接不能写，保证"写主读从"
# 复制回放线程不受 read_only 限制，数据照常写入；
# root 不受 read_only 限制（仍可建账号、CHANGE REPLICATION SOURCE）
read_only = ON
# 需要连 root 也锁死时（且初始化/建账号完成之后），执行：
#   SET PERSIST super_read_only = ON;
