# Campus Repair Assistant — MySQL 8 主库配置（集群 + 读写分离）
# 目标位置：VM1（192.168.56.101）的 /etc/mysql/mysql.conf.d/campus.cnf
# 重启生效：sudo systemctl restart mysql
# 验证监听：sudo ss -lntp | grep 3306
# 从库配置见 mysqld-campus-slave.cnf；复制链路建立见 docs/MySQL读写分离部署文档.md

[mysqld]
# 只监听 Host-Only 地址，不暴露到 NAT/公网
bind-address = 192.168.56.101
mysqlx-bind-address = 127.0.0.1

default-time-zone = '+08:00'
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

max_connections = 200
innodb_buffer_pool_size = 512M

# ===== 主从复制（读写分离）：主库侧 =====
# server-id 必须全局唯一（主 1 / 从 2）；log-bin 开启 binlog，从库据此同步
server-id     = 1
log-bin       = campus-bin
binlog_format = ROW
# MySQL 8 推荐 GTID 复制：从库 CHANGE REPLICATION SOURCE 时用 SOURCE_AUTO_POSITION=1，
# 不需要手工抄写 binlog 文件名和位点
gtid_mode                = ON
enforce_gtid_consistency = ON
