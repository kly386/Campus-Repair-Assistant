# 复制为 .env 后填写；此模板不含真实密钥，可以提交。
# 注意：自助诊断与报修解析是两个独立场景，各自使用自己的 key。

# ===== 报修 AI（DashScope，OpenAI 兼容；负责人：伍梦圆） =====
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-vl-plus

# ===== 自助诊断 - 对话（智谱 GLM，负责人：闵娟） =====
# 只经环境变量注入，禁止写进代码/文档/提交
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flashx-250414

# ===== 自助诊断 - 向量化（硅基流动 BAAI/bge-m3，免费，负责人：闵娟） =====
# 与对话 key 相互独立；bge-m3 不支持 dimensions，请求体不要带该字段
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ===== 数据库 / JWT / 其他 =====
DB_PASSWORD=
JWT_SECRET=
